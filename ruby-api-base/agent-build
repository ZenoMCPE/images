#!/usr/bin/env python3
"""Run a build within this host's shared 75-percent CPU pool."""
import json
import os
import subprocess
import sys

def cpu_budget():
    """Choose a deterministic pool, retaining an enclosing build's pool."""
    allowed = sorted(os.sched_getaffinity(0))
    inherited = os.environ.get("AGENT_BUILD_CPUSET", "")
    if os.environ.get("AGENT_BUILD_BUDGET_APPLIED") == "1" and inherited == ",".join(map(str, allowed)):
        return allowed
    env = dict(os.environ)
    env.pop("OMP_NUM_THREADS", None)
    env.pop("OMP_THREAD_LIMIT", None)
    available = min(len(allowed), int(subprocess.check_output(["nproc"], text=True, env=env).strip()))
    return allowed[:max(1, available * 3 // 4)]

def main():
    """Apply CPU affinity and build-tool limits before executing the command."""
    cpus = cpu_budget()
    jobs = len(cpus)
    if sys.argv[1:] == ["--info"]:
        print(json.dumps({"jobs": jobs, "cpus": cpus}))
        return
    command = sys.argv[1:]
    if command[:1] == ["--"]:
        command = command[1:]
    if not command:
        raise SystemExit("Usage: agent-build [--info | -- COMMAND ARG...]")
    os.sched_setaffinity(0, cpus)
    os.environ["AGENT_BUILD_BUDGET_APPLIED"] = "1"
    os.environ["AGENT_BUILD_CPUSET"] = ",".join(map(str, cpus))
    for key in ("BUILD_JOBS", "MAX_JOBS", "CARGO_BUILD_JOBS", "CMAKE_BUILD_PARALLEL_LEVEL", "GOMAXPROCS", "OMP_NUM_THREADS", "OMP_THREAD_LIMIT", "OPENBLAS_NUM_THREADS", "MKL_NUM_THREADS"):
        os.environ[key] = str(jobs)
    os.environ["MAKEFLAGS"] = (os.environ.get("MAKEFLAGS", "") + " -j" + str(jobs)).strip()
    os.environ["GOFLAGS"] = (os.environ.get("GOFLAGS", "") + " -p=" + str(jobs)).strip()
    os.execvpe(command[0], command, os.environ)

if __name__ == "__main__":
    main()
